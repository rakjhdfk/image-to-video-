    "source_voice": "MeloTTS EN_INDIA SID2",
    "profile": {
      "pitch": 0.69,
      "speed": 0.98,
      "gain": 0.97
    }
  },
  {
    "shot": 13,
    "speaker": "elder",
    "text": "Mira Veyne. Silver Thread Manipulation. Precision beyond your years.",
