    "source_voice": "MeloTTS EN_INDIA SID2",
    "profile": {
      "pitch": 1.0,
      "speed": 1.04,
      "gain": 0.92
    }
  },
  {
    "shot": 55,
    "speaker": "mira",
    "text": "One step at a time. The rail is broken on the inside.",
