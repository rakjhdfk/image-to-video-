    "source_voice": "MeloTTS EN_INDIA SID2",
    "profile": {
      "pitch": 0.82,
      "speed": 1.06,
      "gain": 0.93
    }
  },
  {
    "shot": 12,
    "speaker": "narrator",
    "text": "At the Academy, the awakening crystal gave every gift a name. Today, it would meet an absence.",
