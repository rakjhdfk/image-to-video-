    "source_voice": "MeloTTS EN_INDIA SID2",
    "profile": {
      "pitch": 0.91,
      "speed": 1.12,
      "gain": 0.98
    }
  },
  {
    "shot": 15,
    "speaker": "mira",
    "text": "Breathe, Kael. You are not standing there alone.",
