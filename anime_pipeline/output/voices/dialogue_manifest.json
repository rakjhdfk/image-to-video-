      "gain": 0.98
    }
  },
  {
    "shot": 50,
    "speaker": "mira",
    "text": "We will remember with you. You won't carry this alone.",
    "start": 504.65,
    "end": 507.36249999999995,
    "file": "voices/050_01_mira_84893886d6e1a6c1.wav",
    "source_voice": "MeloTTS EN_INDIA SID2",
    "profile": {
      "pitch": 1.0,
      "speed": 1.04,
      "gain": 0.92
    }
  },
  {
    "shot": 51,
    "speaker": "kael",
    "text": "You recognised that symbol before the crystal broke. Tell me what you know.",
    "start": 510.2,
    "end": 514.7621041666666,
    "file": "voices/051_00_kael_8ad3bcaedbd705c3.wav",
    "source_voice": "MeloTTS EN_INDIA SID2",
    "profile": {
      "pitch": 0.82,
      "speed": 1.06,
      "gain": 0.93
    }
  },
  {
    "shot": 51,
    "speaker": "elder",
    "text": "Yes. I owe you the truth.",
    "start": 515.317,
    "end": 516.7911666666666,
    "file": "voices/051_01_elder_04c34ad9b551f3b7.wav",
    "source_voice": "MeloTTS EN_INDIA SID2",
    "profile": {
      "pitch": 0.69,
      "speed": 0.98,
      "gain": 0.97
    }
  },
  {
    "shot": 52,
    "speaker": "elder",
    "text": "Your mother guarded the first seal. She hid its key inside your unawakened signature.",
    "start": 520.2,
    "end": 525.561,
    "file": "voices/052_00_elder_efb022566f61e188.wav",
    "source_voice": "MeloTTS EN_INDIA SID2",
    "profile": {
      "pitch": 0.69,
      "speed": 0.98,
      "gain": 0.97
    }
  },
  {
    "shot": 52,
    "speaker": "kael",
    "text": "And opening it woke the rift?",
    "start": 525.681,
    "end": 527.2624166666667,
    "file": "voices/052_01_kael_e60cf4f45f856159.wav",
    "source_voice": "MeloTTS EN_INDIA SID2",
    "profile": {
      "pitch": 0.82,
      "speed": 1.06,
      "gain": 0.93
    }
  },
  {
    "shot": 53,
    "speaker": "elder",
    "text": "Something outside felt the lock weaken. The first seal must be closed from within.",
    "start": 530.2,
    "end": 534.72,
    "file": "voices/053_00_elder_21722e11598ac58e.wav",
    "source_voice": "MeloTTS EN_INDIA SID2",
    "profile": {
      "pitch": 0.69,
      "speed": 0.98,
      "gain": 0.97
    }
  },
  {
    "shot": 53,
    "speaker": "kael",
    "text": "Then show us the door.",
    "start": 535.681,
    "end": 536.6219791666667,
    "file": "voices/053_01_kael_d10a7c20f6e01802.wav",
    "source_voice": "MeloTTS EN_INDIA SID2",
    "profile": {
      "pitch": 0.82,
      "speed": 1.06,
      "gain": 0.93
    }
  },
  {
    "shot": 54,
    "speaker": "riven",
    "text": "For the record, I preferred it when our biggest problem was the examination board.",
    "start": 540.2,
    "end": 544.4283125000001,
