    "source_voice": "MeloTTS EN_INDIA SID2",
    "profile": {
      "pitch": 0.82,
      "speed": 1.06,
      "gain": 0.93
    }
  },
  {
    "shot": 16,
    "speaker": "kael",
    "text": "Nothing. I knew it would be nothing.",
