    "source_voice": "MeloTTS EN_INDIA SID2",
    "profile": {
      "pitch": 0.91,
      "speed": 1.12,
      "gain": 0.98
    }
  },
  {
    "shot": 54,
    "speaker": "mira",
    "text": "Keep complaining. It means you are still breathing.",
