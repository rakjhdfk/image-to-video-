    "source_voice": "MeloTTS EN_INDIA SID2",
    "profile": {
      "pitch": 0.69,
      "speed": 0.98,
      "gain": 0.97
    }
  },
  {
    "shot": 17,
    "speaker": "mira",
    "text": "That wasn't an empty reading. Something moved inside the silence.",
