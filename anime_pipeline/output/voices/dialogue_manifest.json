    "source_voice": "MeloTTS EN_INDIA SID2",
    "profile": {
      "pitch": 1.0,
      "speed": 1.04,
      "gain": 0.92
    }
  },
  {
    "shot": 7,
    "speaker": "riven",
    "text": "I complain about control lessons. You would probably work harder than all of us.",
